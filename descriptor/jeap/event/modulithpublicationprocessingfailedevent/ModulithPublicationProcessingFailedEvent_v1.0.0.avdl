@namespace("ch.admin.bit.jeap.modulith.event.publicationprocessingfailed")
protocol ModulithPublicationProcessingFailedEventProtocol {
  import idl "DomainEventBaseTypes.avdl";

  /**
   * The event publication that could not be processed. A publication is one listener's delivery of one
   * internal application event, which is exactly the unit that can be retried or discarded, so its id
   * is the only thing needed to act on it later.
   */
  record ModulithPublicationReference {
    string type = "modulithPublication";
    /** Identifier of the row in the Spring Modulith event publication registry. */
    string publicationId;
  }

  record ModulithPublicationProcessingFailedReferences {
    ModulithPublicationReference publication;
  }

  record ModulithPublicationProcessingFailedPayload {
    /**
     * The listener whose processing failed, as the fully qualified signature of its method. One event
     * is delivered to several listeners, each with its own publication, so the publication id alone
     * does not tell a human which processing step went wrong.
     */
    string listener;
    /** Fully qualified class name of the internal application event that could not be processed. */
    string eventType;
    /** Message of the exception that ended the last processing attempt. */
    string errorMessage;
    /** Stack trace of that exception, used to group errors that share a cause. */
    union{null, string} stackTrace = null;
    /**
     * The event that could not be processed, in the form the publishing application stores it in its
     * event publication registry. Carried as bytes, like the original message of a
     * MessageProcessingFailedEvent, so that it can be displayed even if it cannot be parsed.
     * <p>
     * Best effort and therefore optional: it is absent when the event could not be serialized, and
     * truncated when it would otherwise be too large. An absent payload never prevents the failure
     * from being reported.
     */
    union{null, bytes} serializedEvent = null;
    /**
     * Media type of serializedEvent, for example "application/json". Needed to display the payload:
     * the serialization format is an application-side choice, so it cannot be assumed. Absent exactly
     * when serializedEvent is absent.
     */
    union{null, string} serializedEventContentType = null;
  }

  record ModulithPublicationProcessingFailedEvent {
    ch.admin.bit.jeap.domainevent.avro.AvroDomainEventIdentity identity;
    ch.admin.bit.jeap.domainevent.avro.AvroDomainEventType type;
    ch.admin.bit.jeap.domainevent.avro.AvroDomainEventPublisher publisher;
    ModulithPublicationProcessingFailedReferences references;
    ModulithPublicationProcessingFailedPayload payload;
    string domainEventVersion;
    string? processId = null;
  }
}

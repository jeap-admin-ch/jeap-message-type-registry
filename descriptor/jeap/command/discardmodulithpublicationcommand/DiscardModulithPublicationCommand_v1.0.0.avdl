@namespace("ch.admin.bit.jeap.modulith.command.discardpublication")
protocol DiscardModulithPublicationCommandProtocol {
  import idl "MessagingBaseTypes.avdl";

  /**
   * The event publication to discard. A publication is one listener's delivery of one internal
   * application event, so its id identifies exactly what is to be given up on.
   */
  record ModulithPublicationReference {
    string type = "modulithPublication";
    /** Identifier of the row in the Spring Modulith event publication registry. */
    string publicationId;
  }

  record DiscardModulithPublicationCommandReferences {
    ModulithPublicationReference publication;
  }

  record DiscardModulithPublicationCommandPayload {
    /**
     * Why the publication was given up on, for the log of the application that discards it. Optional:
     * the authoritative record of the decision stays with the Error Handling Service it was taken in,
     * so a discard without a reason is just as valid.
     */
    string? reason = null;
  }

  record DiscardModulithPublicationCommand {
    ch.admin.bit.jeap.messaging.avro.AvroMessageIdentity identity;
    ch.admin.bit.jeap.messaging.avro.AvroMessageType type;
    ch.admin.bit.jeap.messaging.avro.AvroMessagePublisher publisher;
    DiscardModulithPublicationCommandReferences references;
    DiscardModulithPublicationCommandPayload payload;
    string? processId = null;
    string commandVersion;
  }
}
